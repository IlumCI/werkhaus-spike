{
  "type": "object",
  "additionalProperties": false,
  "required": ["token_name", "symbol", "tagline", "lock_days", "cooldown_hours", "min_stake_tokens", "page_sections"],
  "properties": {
    "token_name": {"type": "string", "minLength": 3, "maxLength": 32},
    "symbol": {"type": "string", "pattern": "^[A-Z]{3,6}$"},
    "tagline": {"type": "string", "minLength": 10, "maxLength": 90},
    "lock_days": {"type": "integer", "minimum": 0, "maximum": 365},
    "cooldown_hours": {"type": "integer", "minimum": 0, "maximum": 168},
    "min_stake_tokens": {"type": "integer", "minimum": 1, "maximum": 1000000},
    "page_sections": {
      "type": "array",
      "minItems": 3,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["heading", "body"],
        "properties": {
          "heading": {"type": "string", "minLength": 3, "maxLength": 40},
          "body": {"type": "string", "minLength": 20, "maxLength": 280}
        }
      }
    }
  }
}
